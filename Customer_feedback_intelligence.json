        "jsonBody": "=\n{{ JSON.stringify({\n  model: \"openai/gpt-oss-120b\",\n  temperature: 0.2,\n  max_tokens: 800,\n  messages: [\n    {\n      role: \"system\",\n      content: \"Analyze customer feedback and return valid JSON with category, product, severity, confidence, and reason.\"\n    },\n    {\n      role: \"user\",\n      content: JSON.stringify($json.body || $json)\n    }\n  ]\n}) }}\n",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "={{ 'Bearer ' + $env.GROQ_API_KEY }}"
