              "value": "application/json"
            }
          ]
        }
      },
      "id": "7a657923-9530-4424-9c20-1152c47a3169",
      "name": "Analyze Feedback with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        176,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const data = $('Webhook').first().json.body || {};\nconst raw = ($input.first().json.choices?.[0]?.message?.content || '').trim();\n\nlet ai = {};\ntry {\n  const cleaned = raw.replace(/^\\s*\\x60\\x60\\x60(?:json)?/i, '').replace(/\\x60\\x60\\x60\\s*$/, '').trim();\n  const start = cleaned.indexOf('{');\n  const end = cleaned.lastIndexOf('}');\n  ai = JSON.parse(start >= 0 && end > start ? cleaned.slice(start, end + 1) : cleaned);\n} catch (e) {\n  ai = {};\n}\n\nconst toText = (v) => Array.isArray(v) ? v.join(', ') : (v == null ? '' : String(v));\n\nreturn [{\n  json: {\n    Email_ID: data.email || ('no-email-' + Date.now()),\n    Category: toText(ai.category) || data.category || 'Uncategorized',\n    Product: toText(ai.product) || 'Not specified',\n    Severity: toText(ai.severity) || 'Unknown',\n    Confidence: toText(ai.confidence) || '',\n    Reason: toText(ai.reason) || 'Not available',\n    Review_Status: 'Pending Review',\n    Received_Date: new Date().toISOString()\n  }\n}];"
      },
